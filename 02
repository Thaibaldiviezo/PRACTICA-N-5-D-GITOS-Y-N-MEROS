#include <iostream>
using namespace std;

int invertir(int n);

int main()
{
    int n;

    cout << "Ingrese un numero: ";
    cin >> n;

    cout << "Numero invertido: " << invertir(n);

    return 0;
}

int invertir(int n)
{
    int inv = 0, d;

    while (n > 0)
    {
        d = n % 10;
        inv = inv * 10 + d;
        n = n / 10;
    }

    return inv;
}
